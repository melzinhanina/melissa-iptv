# Álbum público do Google Fotos
PHOTOS_ALBUM_URL=

# Endereço público do app
PUBLIC_URL=https://melissa-iptv.hostless.app

# Token opcional para proteger API, playlists e streams
IPTV_TOKEN=

# Buffer máximo de avanço por vídeo ativo (bytes; padrão 2 MiB)
RANGE_BUFFER_BYTES=2097152

# Máximo de vídeos com streams ativos simultaneamente
MAX_ACTIVE_STREAMS=12

# Tempo de retenção de estados inativos (ms; padrão 10 minutos)
RANGE_STATE_TTL_MS=600000

# Diretório temporário gravável no Hostless
DATA_DIR=/tmp/melissa-iptv
