# Álbum público do Google Fotos (o link padrão já está em start.js)
PHOTOS_ALBUM_URL=

# Endereço público do app
PUBLIC_URL=https://melissa-iptv.hostless.app

# Token opcional para proteger API, playlists e segmentos
IPTV_TOKEN=

# Duração-alvo dos segmentos HLS (segundos; padrão 6)
HLS_SEGMENT_SECONDS=6

# Limite do cache HLS em /tmp (bytes; padrão 400 MiB)
MAX_HLS_BYTES=419430400

# Tempo máximo para gerar uma playlist (ms; padrão 15 minutos)
HLS_TIMEOUT_MS=900000

# Diretório temporário gravável no Hostless
DATA_DIR=/tmp/melissa-iptv
